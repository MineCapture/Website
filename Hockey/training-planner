<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>Stokesley Hockey Training Planner v8.3</title>
<style>
:root{--navy:#073b78;--blue:#0d6fb8;--bg:#eef4f8;--card:#fff;--border:#d8e2e9;--text:#1e2932;--muted:#66737d;--good:#147346;--warn:#a76300;--danger:#a32020;--yellow:#ffd400;--red:#d71920;--astro:#1379c4}
*{box-sizing:border-box}body{margin:0;font-family:Arial,Helvetica,sans-serif;background:var(--bg);color:var(--text);font-size:14px}button,input,select,textarea{font:inherit}button{cursor:pointer;border:0;border-radius:8px;background:var(--navy);color:#fff;font-weight:700;padding:9px 12px}button:hover{background:#095b98}button:disabled{cursor:default;opacity:.9}button.secondary{background:#5b6670}button.ghost{background:#e8f2f8;color:var(--navy)}button.danger{background:var(--danger)}button.good{background:var(--good)}button.small{padding:5px 8px;font-size:12px}input,select,textarea{width:100%;padding:8px;border:1px solid #b9c6cf;border-radius:7px;background:#fff}textarea{min-height:78px;resize:vertical}label{display:block;font-size:12px;font-weight:700;margin:9px 0 4px}.hidden{display:none!important}.meta{font-size:12px;color:var(--muted);line-height:1.4}.buttons{display:flex;gap:8px;flex-wrap:wrap}.tag{display:inline-block;padding:3px 7px;margin:2px;border-radius:999px;background:#e8f2f8;color:var(--navy);font-size:11px}.tag.primary{background:#eaf7ef;color:#12633d}.tag.gk{background:#fff4c7;color:#5d4b00}
header{height:64px;background:var(--navy);color:#fff;display:flex;align-items:center;justify-content:space-between;padding:0 18px;position:sticky;top:0;z-index:30}.brand h1{font-size:19px;margin:0}.brand .sub{font-size:11px;opacity:.85;margin-top:2px}.topnav{display:flex;gap:7px}.topnav button.active{background:#fff;color:var(--navy)}
.page{padding:18px;max-width:1440px;margin:0 auto}.home-head{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:18px}.home-head h2{font-size:24px;margin:0}.section-title{font-size:14px;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);margin:20px 0 8px}.session-list{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:12px}.session-card{background:#fff;border:1px solid var(--border);border-radius:12px;padding:14px;box-shadow:0 2px 7px rgba(0,0,0,.05)}.session-card h3{margin:0 0 5px;font-size:17px}.status{display:inline-block;font-size:11px;font-weight:800;padding:4px 8px;border-radius:999px}.status.draft{background:#fff1cc;color:#744d00}.status.committed{background:#e5f5ec;color:#12633d}.progress{height:7px;background:#e5ebef;border-radius:99px;overflow:hidden;margin:10px 0}.progress span{height:100%;display:block;background:var(--blue)}.empty-state{background:#fff;border:1px dashed #b8c6d0;border-radius:12px;padding:38px;text-align:center;color:var(--muted)}
.builder{display:grid;grid-template-columns:330px minmax(0,1fr);gap:14px;max-width:none;padding:14px}.sidebar{background:#fff;border-radius:12px;box-shadow:0 2px 8px rgba(0,0,0,.07);overflow:hidden;align-self:start;position:sticky;top:78px;max-height:calc(100vh - 94px);display:flex;flex-direction:column}.session-mini{padding:14px;border-bottom:1px solid var(--border)}.session-mini h2{margin:0 0 4px;font-size:17px}.timeline{overflow:auto;padding:8px}.tl-row{border-radius:10px;padding:10px 10px;margin-bottom:7px;border:1px solid var(--border);cursor:pointer;position:relative;transition:background .15s,border-color .15s,box-shadow .15s}.tl-row:hover{background:#f3f8fb}.tl-row.active{background:#e8f2f8;border-color:#9fc6e1;box-shadow:0 1px 5px rgba(7,59,120,.08)}.tl-row.complete{border-left:5px solid var(--good)}.tl-row.pending{border-left:5px solid #d89b16}.tl-top{display:flex;gap:8px;align-items:flex-start;padding-right:38px}.tl-time{font-size:11px;font-weight:800;color:var(--navy);width:70px;flex:0 0 70px}.tl-name{font-weight:700;line-height:1.25}.tl-status-icon{position:absolute;right:10px;top:9px;width:28px;height:28px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:20px;font-weight:900;line-height:1}.tl-status-icon.complete{background:#e5f5ec;color:var(--good)}.tl-status-icon.pending{background:#fff2cf;color:#996500}.slot-line{display:flex;align-items:center;gap:6px;margin:5px 38px 0 78px;font-size:11px;color:var(--muted)}.slot-line.assigned{color:var(--text);font-weight:700}.slot-dot{width:8px;height:8px;border-radius:50%;background:#d89b16;flex:none}.slot-dot.done{background:var(--good)}.sidebar-foot{padding:10px;border-top:1px solid var(--border);background:#fafcfd}.sidebar-foot button{width:100%;margin-top:6px}
.workspace{background:#fff;border-radius:12px;box-shadow:0 2px 8px rgba(0,0,0,.07);min-height:calc(100vh - 92px);padding:18px}.workspace-head{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;border-bottom:1px solid var(--border);padding-bottom:12px;margin-bottom:14px}.workspace h2{font-size:23px;margin:0 0 4px}.filterbar{display:grid;grid-template-columns:minmax(220px,1fr) 220px auto;gap:8px;align-items:end;margin-bottom:14px}.filterbar label{margin-top:0}.drill-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(420px,1fr));gap:10px}.drill-card{border:1px solid var(--border);border-radius:10px;padding:10px;background:#fff;display:grid;grid-template-columns:180px minmax(0,1fr);gap:12px;min-height:130px;transition:opacity .15s,border-color .15s,box-shadow .15s,transform .15s}.drill-card[draggable=true]{cursor:grab}.drill-card h3{margin:0 0 5px;font-size:16px}.drill-card p{font-size:13px;line-height:1.35;margin:7px 0}.drill-card .buttons{margin-top:8px}.drill-card.assigned{border:3px solid var(--navy);box-shadow:0 3px 12px rgba(7,59,120,.16);transform:translateY(-1px)}.drill-card.assigned .assigned-badge{display:inline-block}.assigned-badge{display:none;background:var(--navy);color:#fff;font-size:11px;font-weight:800;border-radius:999px;padding:4px 8px;margin-bottom:5px}.picker-grid.has-assigned .drill-card:not(.assigned){opacity:.68}.picker-grid.has-assigned .drill-card:not(.assigned):hover{opacity:1}.card-diagram{align-self:start;background:#0b5f9e;border-radius:8px;padding:4px;overflow:hidden}.card-diagram .pitchsvg{margin:0;border-radius:6px}.card-body{min-width:0;display:flex;flex-direction:column}.card-body .buttons{margin-top:auto}.overview-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.overview-grid.two{grid-template-columns:repeat(2,1fr)}.assigned-card{border:1px solid var(--border);border-radius:10px;padding:12px;background:#fbfdfe;min-height:150px}.assigned-card.empty{border-style:dashed;color:var(--muted)}.assigned-card h3{margin:0 0 6px}.drop-target.dragover{outline:3px solid #79add1;background:#eef8ff}.locked-banner{background:#e8f5ed;border:1px solid #b9dcc8;border-radius:9px;padding:10px;margin-bottom:12px;color:#125f39}.note{padding:9px;border-radius:8px;background:#f5f9fb;border:1px dashed #bdcad3}.row{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.modal{position:fixed;inset:0;background:rgba(0,0,0,.58);z-index:60;display:flex;align-items:flex-start;justify-content:center;padding:26px 10px;overflow:auto}.modal-content{background:#fff;width:min(980px,100%);border-radius:13px;padding:17px;box-shadow:0 15px 40px rgba(0,0,0,.28)}.modal-content.narrow{max-width:620px}.close-row{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:8px}.close-row h2{margin:0}.lookup-box{display:flex;flex-wrap:wrap;gap:6px;margin-top:5px}.checkpill{display:flex;align-items:center;gap:5px;border:1px solid #c2d0d9;border-radius:999px;padding:5px 8px;background:#f8fbfd;font-size:12px}.checkpill input{width:auto}.diagram-wrap{background:#0b5f9e;border-radius:9px;padding:5px;margin:7px 0}.pitchsvg{width:100%;height:auto;display:block;background:var(--astro);border-radius:8px;border:1px solid #0a528c}.diagram-editor{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:12px;min-height:0;height:100%}.canvasbox{background:#0b5f9e;border-radius:10px;padding:8px;min-height:0;display:flex;align-items:center;justify-content:center;overflow:hidden}.diagram-editor svg{width:100%;height:100%;max-width:100%;max-height:100%;touch-action:none}.toolbox{display:flex;gap:5px;flex-wrap:wrap}.toolbox button{padding:6px 8px}#diagramModal.modal{padding:0;align-items:stretch;overflow:hidden}#diagramModal .modal-content{width:100vw;height:100vh;max-width:none;border-radius:0;padding:12px;display:grid;grid-template-rows:auto minmax(0,1fr);overflow:hidden}#diagramModal .close-row{margin-bottom:8px}#diagramModal .diagram-editor>div:last-child{overflow:auto;padding:2px 4px 2px 0}
.pitch-view-controls{border:1px solid var(--border);border-radius:9px;padding:8px;background:#f7fbff;margin-bottom:8px}.pitch-preset-row{display:flex;gap:5px;flex-wrap:wrap}.pitch-preset-row button{background:#e8f2f8;color:var(--navy);border:1px solid #bdd3e3;padding:6px 8px}.pitch-preset-row button.active{background:var(--navy);color:#fff;border-color:var(--navy)}.marking-checks{display:grid;grid-template-columns:1fr 1fr;gap:5px;margin-top:8px}.marking-checks label{margin:0;display:flex;align-items:center;gap:6px;font-weight:600}.marking-checks input{width:auto;margin:0}.assigned-card .assigned-diagram{margin:10px 0}.assigned-card .assigned-diagram .pitchsvg{max-height:280px}.assigned-card .buttons{margin-top:10px}

