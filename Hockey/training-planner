  .print-head h1{margin:0;font-size:17pt;color:#073b78}.print-head h2{margin:1mm 0 0;font-size:12pt}.print-meta{font-size:8.5pt;color:#52606a;line-height:1.3}.print-time{font-size:13pt;font-weight:800;background:#e8f2f8;color:#073b78;border-radius:999px;padding:2mm 4mm;white-space:nowrap}
