@media(max-width:900px){.builder{grid-template-columns:1fr}.sidebar{position:static;max-height:none}.timeline{max-height:330px}.overview-grid,.overview-grid.two{grid-template-columns:1fr}.filterbar{grid-template-columns:1fr}.row{grid-template-columns:1fr}#diagramModal .diagram-editor{grid-template-columns:minmax(0,1fr) 240px}.topnav button span{display:none}.drill-grid{grid-template-columns:1fr}.drill-card{grid-template-columns:150px minmax(0,1fr)}}@media(max-width:620px){.drill-card{grid-template-columns:1fr}.card-diagram{max-width:300px}.training-grid,.training-grid.two{grid-template-columns:1fr}.training-single{grid-template-columns:1fr}.pitch-main{overflow:auto}.pitch-mode{overflow:hidden}}@media(orientation:landscape) and (max-height:700px){.pitch-head,.pitch-foot{padding:5px 8px}.pitch-main{padding:5px 0}.training-card{padding:7px}.training-grid .training-card .pitchsvg{max-height:20vh}.training-single-info{padding:7px 9px}.training-single-info h2{font-size:clamp(15px,1.7vw,22px)}.training-single-info p,.training-single-info li{font-size:clamp(10px,.85vw,13px)}.rating-row button{min-width:22px;padding:3px 4px}}
.print-pack{display:none}
@page{size:A4 landscape;margin:8mm}
