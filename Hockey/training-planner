async function importDrillsFile(e){const input=e.target,f=input.files?.[0];if(!f)return;let data;try{data=JSON.parse(await f.text())}catch{input.value='';return alert('Invalid JSON file.')}let rows=Array.isArray(data)?data:data?.drills;if(!Array.isArray(rows)){input.value='';return alert('This file does not contain a drill library. Expected a "drills" array.')}rows=rows.filter(x=>x&&typeof x==='object').map(normaliseDrill).filter(d=>d.id&&d.name);if(!rows.length){input.value='';return alert('No valid drills were found in this file.')}const existing=new Set((await getAll('drills')).map(d=>d.id)),conflicts=rows.filter(d=>existing.has(d.id));let overwrite=true;if(conflicts.length){overwrite=confirm(`${conflicts.length} imported drill${conflicts.length===1?' has':'s have'} the same ID as an existing drill.\n\nOK = overwrite matching drills.\nCancel = keep existing versions and import only new drills.`)}let imported=0,skipped=0;for(const d of rows){if(existing.has(d.id)&&!overwrite){skipped++;continue}await put('drills',d);imported++}drills=(await getAll('drills')).map(normaliseDrill);populateSelects();renderLibrary();renderStorageStats();input.value='';alert(`Drill import complete. ${imported} drill${imported===1?'':'s'} imported${skipped?`; ${skipped} existing drill${skipped===1?'':'s'} kept`:''}.`)}
