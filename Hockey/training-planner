  .print-info h2,.print-card h2{font-size:13pt;margin:0 0 1.5mm}.print-info h3,.print-card h3{font-size:9pt;margin:2mm 0 .8mm}.print-info p,.print-info li,.print-card p,.print-card li{font-size:8.2pt;line-height:1.25}.print-info p,.print-card p{margin:1.2mm 0}.print-info ul,.print-card ul{margin:1mm 0 1mm 5mm;padding:0}
  .print-grid{height:100%;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:3mm;min-height:0}.print-grid.two{grid-template-columns:repeat(2,minmax(0,1fr))}
