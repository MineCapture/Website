function selectActivity(id){activeKey=id;renderBuilder()}
function addDrillActivity(){if(currentSession.status==='committed')return;const pc=currentSession.activities.findIndex(a=>a.type==='penalty'),game=currentSession.activities.findIndex(a=>a.type==='game');const idx=(activeKey&&activityById(activeKey))?Math.min(currentSession.activities.findIndex(a=>a.id===activeKey)+1,game):game;const a={id:flexId(),type:'drill',title:'Drill',duration:15,note:'',drillId:null};currentSession.activities.splice(Math.max(1,idx),0,a);activeKey=a.id;renderBuilder()}
