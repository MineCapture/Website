function renderFlexPicker(id,parallel){const a=activityById(id),q=(document.getElementById('flexPickerSearch')?.value||'').toLowerCase(),focus=document.getElementById('flexPickerFocus')?.value||'';let arr=drills.filter(d=>activityCompat(d,a.type,parallel)).filter(d=>{const h=[d.name,d.primaryFocus,...(d.secondaryTags||[]),d.setup].join(' ').toLowerCase();return(!q||h.includes(q))&&(!focus||d.primaryFocus===focus)}).sort((x,y)=>x.name.localeCompare(y.name));flexPickerGrid.innerHTML=arr.length?arr.map(d=>`<div class="drill-card">${compactDiagramHTML(d.diagram)}<div class="card-body"><h3>${esc(d.name)}</h3><div>${tagHTML(d)}</div><p>${esc(shortSetup(d.setup))}</p><div class="buttons"><button onclick="assignActivityDrill('${id}','${d.id}',${parallel})">Assign</button><button class="ghost" onclick="previewDrill('${d.id}')">Details</button></div></div></div>`).join(''):'<div class="empty-state">No matching drills.</div>'}
function assignActivityDrill(id,drillId,parallel){const a=activityById(id);if(!a)return;if(parallel)a.parallelDrillId=drillId;else a.drillId=drillId;activeKey=id;renderBuilder()}
async function saveDraft(){if(!currentSession)return;currentSession.updatedAt=new Date().toISOString();await put('sessions',clone(currentSession));sessions=await getAll('sessions');renderBuilder();alert('Draft saved.')}
async function commitSession(){const missing=currentSession.activities.filter(a=>!a.drillId);if(missing.length)return alert('Assign a drill to every main activity first. Missing: '+missing.map(a=>a.title||flexTypeLabel(a.type)).join(', '));const sum=scheduleSummary();let msg='Commit this session? It will be locked for Training Night.';if(sum.delta!==0)msg+=`\n\nThe planned activities total ${sum.used} minutes against ${sum.cap} available (${Math.abs(sum.delta)} minutes ${sum.delta>0?'unallocated':'over'}).`;if(!confirm(msg))return;currentSession.status='committed';currentSession.committedAt=new Date().toISOString();currentSession.updatedAt=currentSession.committedAt;await put('sessions',clone(currentSession));sessions=await getAll('sessions');renderBuilder()}
function renderCommittedWorkspace(){const sum=scheduleSummary();workspace.innerHTML=`<div class="locked-banner"><strong>Committed session.</strong> The plan is locked from editing and ready for Training Night.</div><div class="workspace-head"><div><h2>${esc(currentSession.title)}</h2><div class="meta">${esc(currentSession.date)} · ${esc(currentSession.startTime)}–${esc(currentSession.finishTime)} · ${sum.used} min planned</div></div><div class="buttons"><button onclick="openTrainingMode()">Start Training Night</button><button class="secondary" onclick="printTrainingPack()">Print / PDF</button><button class="secondary" onclick="reopenSession()">Reopen for Editing</button></div></div>${currentSession.activities.map((a,i)=>{const d=activityDrill(a),p=activityDrill(a,true);return `<div style="padding:10px;border-bottom:1px solid var(--border)"><strong>${activityStart(i)}–${activityEnd(i)} ${esc(a.title||flexTypeLabel(a.type))}</strong><div class="meta" style="margin-top:4px">${esc(d?.name||'')}</div>${a.type==='penalty'&&p?`<div class="meta">Others: ${esc(p.name)}</div>`:''}</div>`}).join('')}`}
function trainingBlocks(){return currentSession?.activities||[]}
function trainingCardByDrill(d,label=''){if(!d)return`<div class="training-card"><h2>${esc(label||'No drill assigned')}</h2></div>`;const st=ratingStats(d.id);return `<div class="training-card"><h2>${label?esc(label)+': ':''}${esc(d.name)}</h2><div class="meta">${esc(d.primaryFocus)}${st.count?' · Avg '+st.avg.toFixed(1)+'/10':''}</div>${trainingDiagram(d)}<p><strong>Setup:</strong> ${esc(d.setup||'')}</p>${d.rules?`<p><strong>Rules:</strong> ${esc(d.rules)}</p>`:''}${d.coaching?.length?`<h3>Coaching Points</h3><ul>${d.coaching.slice(0,4).map(x=>`<li>${esc(x)}</li>`).join('')}</ul>`:''}${ratingButtonsHTML(d)}</div>`}
function trainingSingleByDrill(d){if(!d)return'';const st=ratingStats(d.id);return `<div class="training-single"><div class="training-single-diagram">${trainingDiagram(d)}</div><div class="training-single-info"><h2>${esc(d.name)}</h2><div class="meta">${esc(d.primaryFocus)}${st.count?' · Avg '+st.avg.toFixed(1)+'/10':''}</div><p><strong>Setup:</strong> ${esc(d.setup||'')}</p>${d.rules?`<p><strong>Rules:</strong> ${esc(d.rules)}</p>`:''}${d.coaching?.length?`<h3>Coaching Points</h3><ul>${d.coaching.slice(0,4).map(x=>`<li>${esc(x)}</li>`).join('')}</ul>`:''}${d.variations?`<p><strong>Variation:</strong> ${esc(d.variations)}</p>`:''}${ratingButtonsHTML(d)}</div></div>`}
function renderTrainingMode(){const arr=trainingBlocks(),a=arr[tmIndex],next=arr[tmIndex+1],d=activityDrill(a),p=activityDrill(a,true);tmTitle.textContent=`${tmIndex+1}/${arr.length}. ${a.title||flexTypeLabel(a.type)}`;tmMeta.textContent=sessionThemeText(currentSession);tmTime.textContent=`${activityStart(tmIndex)}–${activityEnd(tmIndex)}`;if(a.type==='penalty'&&p)tmMain.innerHTML=`<div class="training-grid two pc-parallel">${trainingCardByDrill(d,'Penalty Corners')}${trainingCardByDrill(p,'Other Players')}</div>`;else tmMain.innerHTML=trainingSingleByDrill(d);tmNext.textContent=next?`Next: ${activityStart(tmIndex+1)} ${next.title||flexTypeLabel(next.type)}`:'Final block'}
function printCardByDrill(d,label=''){if(!d)return'';return `<div class="print-card"><h2>${label?esc(label)+': ':''}${esc(d.name)}</h2><div class="print-meta">${esc(d.primaryFocus||'')}</div>${printDiagram(d)}<p><strong>Setup:</strong> ${esc(d.setup||'')}</p>${d.rules?`<p><strong>Rules:</strong> ${esc(d.rules)}</p>`:''}${d.coaching?.length?`<h3>Coaching Points</h3><ul>${d.coaching.slice(0,3).map(x=>`<li>${esc(x)}</li>`).join('')}</ul>`:''}</div>`}
function renderPrintActivityPage(session,a,i,total){const d=drills.find(x=>x.id===a.drillId),p=a.parallelDrillId?drills.find(x=>x.id===a.parallelDrillId):null;let body;if(a.type==='penalty'&&p)body=`<div class="print-grid two">${printCardByDrill(d,'Penalty Corners')}${printCardByDrill(p,'Other Players')}</div>`;else body=`<div class="print-single"><div class="print-diagram">${printDiagram(d)}</div><div class="print-info">${printInfo(d,true)}</div></div>`;let t=session.startTime||'19:05';for(let j=0;j<i;j++)t=addMinutes(t,session.activities[j].duration);const end=addMinutes(t,a.duration),next=session.activities[i+1];return `<section class="print-page"><div class="print-head"><div><h1>${esc(session.title)}</h1><h2>${esc(a.title||flexTypeLabel(a.type))}</h2><div class="print-meta">${esc(session.date)} · ${esc(sessionThemeText(session))}</div></div><div class="print-time">${t}–${end}</div></div><div class="print-body">${body}</div><div class="print-footer"><span>${a.note?`<strong>Note:</strong> ${esc(a.note)}`:''}</span><span>Page ${i+1} of ${total} · <strong>${next?'Next: '+addMinutes(end,0)+' '+(next.title||flexTypeLabel(next.type)):'Final activity'}</strong></span></div></section>`}
function buildPrintPack(session){session=ensureSessionShape(session);printPack.innerHTML=session.activities.map((a,i)=>renderPrintActivityPage(session,a,i,session.activities.length)).join('')}
async function printTrainingPackById(id){const raw=sessions.find(x=>x.id===id)||(await getAll('sessions')).find(x=>x.id===id);if(!raw)return;const s=ensureSessionShape(clone(raw));if(s.status!=='committed')return alert('Commit the session before printing the Training Pack.');buildPrintPack(s);setTimeout(()=>window.print(),60)}
function printTrainingPack(){if(!currentSession||currentSession.status!=='committed')return alert('Commit the session before printing the Training Pack.');buildPrintPack(currentSession);setTimeout(()=>window.print(),60)}
async function exportAllData(){const data={version:'8.3',exportedAt:new Date().toISOString(),drills:await getAll('drills'),sessions:(await getAll('sessions')).map(ensureSessionShape),ratings:await getAll('ratings')};downloadJsonFile('stokesley-hockey-v8-3-backup.json',data)}

init();
</script></body></html>