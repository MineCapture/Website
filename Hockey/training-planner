function renderPrintPage(session,b,pageNo,total){const next=printableNext(b),br=breakAfterBlock(b);let body='';if(b.kind==='stations')body=`<div class="print-grid">${b.slots.map(k=>printCardFor(session,k)).join('')}</div>`;else if(b.kind==='specialist')body=`<div class="print-grid two">${b.slots.map(k=>printCardFor(session,k)).join('')}</div>`;else{const d=printDrillAt(session,b.slot);body=`<div class="print-single"><div class="print-diagram">${printDiagram(d)}</div><div class="print-info">${printInfo(d,true)}</div></div>`}const transition=br?`${br.start}–${br.end} ${br.title}`:'';const nextText=next?`Next: ${next.start}–${next.end} ${next.title}`:'Final activity';return `<section class="print-page"><div class="print-head"><div><h1>${esc(session.title)}</h1><h2>${esc(b.title)}</h2><div class="print-meta">${esc(session.date)} · ${esc(sessionThemeText(session))}</div></div><div class="print-time">${b.start}–${b.end}</div></div><div class="print-body">${body}</div><div class="print-footer"><span>${transition?`<strong>Break:</strong> ${esc(transition)}`:''}</span><span>Page ${pageNo} of ${total} · <strong>${esc(nextText)}</strong></span></div></section>`}
