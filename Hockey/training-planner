function renderPitchControls(){const vertical=editorPitchOrientation==='tb';const areaLabels=vertical?{full:'Full Pitch',leftHalf:'Bottom Half',rightHalf:'Top Half',left23:'Bottom 23',right23:'Top 23',leftD:'Bottom D',rightD:'Top D',blank:'Blank'}:{full:'Full Pitch',leftHalf:'Left Half',rightHalf:'Right Half',left23:'Left 23',right23:'Right 23',leftD:'Left D',rightD:'Right D',blank:'Blank'};document.querySelectorAll('#pitchAreaRow button').forEach(b=>{b.classList.toggle('active',b.dataset.area===editorPitchArea);if(areaLabels[b.dataset.area])b.textContent=areaLabels[b.dataset.area]});document.querySelectorAll('#pitchOrientationRow button').forEach(b=>b.classList.toggle('active',b.dataset.orientation===editorPitchOrientation));const markLabels=vertical?{left23:'Bottom 23',right23:'Top 23',leftD:'Bottom D',rightD:'Top D',leftSpot:'Bottom penalty spot',rightSpot:'Top penalty spot',leftGoal:'Bottom goal',rightGoal:'Top goal'}:{left23:'Left 23',right23:'Right 23',leftD:'Left D',rightD:'Right D',leftSpot:'Left penalty spot',rightSpot:'Right penalty spot',leftGoal:'Left goal',rightGoal:'Right goal'};const m={...defaultMarkingsForArea(editorPitchArea),...(editorPitchMarkings||{})};document.querySelectorAll('#customMarkings input[data-mark]').forEach(x=>{x.checked=!!m[x.dataset.mark];const label=x.closest('label');if(label&&markLabels[x.dataset.mark]){for(const node of [...label.childNodes])if(node.nodeType===3)node.remove();label.appendChild(document.createTextNode(' '+markLabels[x.dataset.mark]))}});const activePreset=activeMarkingPreset();document.querySelectorAll('#markingPresetRow button[data-marking-preset]').forEach(b=>b.classList.toggle('active',b.dataset.markingPreset===activePreset))}
