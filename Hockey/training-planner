.toolbox button.tool-active{background:var(--yellow);color:#111;box-shadow:0 0 0 2px #111 inset}.toolbox button.tool-muted{opacity:.52}.tool-status{margin:8px 0;padding:8px 10px;border-radius:8px;background:#eef6fb;border:1px solid var(--border);font-weight:700;color:var(--navy)}.object-scale-row{display:flex;gap:5px;margin:6px 0 10px}.object-scale-row button{background:#e8eef3;color:#222;padding:5px 8px}.object-scale-row button.active{background:var(--navy);color:#fff}.diagram-editor.delete-mode .canvasbox{cursor:not-allowed}.diagram-editor.add-mode .canvasbox{cursor:crosshair}.diagram-editor.select-mode .canvasbox{cursor:default}.editor-selected>*{filter:drop-shadow(0 0 1.4px #00ffff)}.zone-preview{pointer-events:none}

