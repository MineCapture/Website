const FLEX_SESSION_REV='8.3';
function flexId(prefix='a'){return prefix+'_'+Date.now()+'_'+Math.random().toString(36).slice(2,6)}
function flexTypeLabel(t){return({warmup:'Warm-up',drill:'Drill',penalty:'Penalty Corners',game:'Match'})[t]||'Activity'}
function activityCompat(d,type,parallel=false){
  const vals=d?.suitableFor||[];
  if(type==='warmup')return vals.some(x=>['Warm-up','Routine Warm-up'].includes(x));
  if(type==='penalty'&&!parallel)return vals.some(x=>['Penalty Corners','Penalty Corner'].includes(x));
  if(type==='game')return vals.some(x=>['Game'].includes(x));
  if(type==='drill'||parallel)return vals.some(x=>['Drill','Station','Technique Lab','Large / Team Drill'].includes(x));
  return true;
}
function defaultActivities(){return[
  {id:flexId(),type:'warmup',title:'Warm-up',duration:15,note:'',drillId:null},
  {id:flexId(),type:'penalty',title:'Penalty Corners',duration:15,note:'',drillId:null,parallelDrillId:null},
  {id:flexId(),type:'game',title:'Match',duration:30,note:'',drillId:null}
]}
function frameworkToActivities(s){
  const f=s.framework||{}; const a=[];
  if(f.warmup)a.push({id:flexId(),type:'warmup',title:'Warm-up',duration:15,note:'',drillId:f.warmup});
  for(const k of ['station1','station2','station3'])if(f[k])a.push({id:flexId(),type:'drill',title:'Drill',duration:12,note:'',drillId:f[k]});
  if(f.pc||f.technique)a.push({id:flexId(),type:'penalty',title:'Penalty Corners',duration:15,note:'',drillId:f.pc||null,parallelDrillId:f.technique||null});
  if(f.large)a.push({id:flexId(),type:'drill',title:'Drill',duration:20,note:'',drillId:f.large});
  if(f.game)a.push({id:flexId(),type:'game',title:'Match',duration:30,note:'',drillId:f.game});
  return a.length?a:defaultActivities();
}
function normaliseActivity(a){
  const type=['warmup','drill','penalty','game'].includes(a?.type)?a.type:(a?.type==='rotation2'?'drill':'drill');
  if(a?.type==='rotation2'){
    const d=a.drillA||a.drillB||null;
    return {id:a.id||flexId(),type:'drill',title:a.title||'Drill',duration:Number(a.duration)||15,note:a.note||'',drillId:d};
  }
  return {id:a?.id||flexId(),type,title:a?.title||flexTypeLabel(type),duration:Math.max(1,Number(a?.duration)||15),note:a?.note||'',drillId:a?.drillId||null,parallelDrillId:type==='penalty'?(a?.parallelDrillId||a?.drillB||null):undefined};
}
function ensureAnchorOrder(arr){
  arr=(arr||[]).map(normaliseActivity);
  let warm=arr.find(x=>x.type==='warmup')||defaultActivities()[0];
  let pc=arr.find(x=>x.type==='penalty')||defaultActivities()[1];
  let game=arr.find(x=>x.type==='game')||defaultActivities()[2];
  const drills=arr.filter(x=>x.type==='drill');
  const original=arr.filter(x=>x!==warm&&x!==pc&&x!==game&&x.type!=='drill');
  // Preserve whether drills were before or after PC when possible.
  const pcIdx=arr.indexOf(pc);
  const before=drills.filter(x=>arr.indexOf(x)<pcIdx),after=drills.filter(x=>arr.indexOf(x)>pcIdx);
  return [warm,...before,pc,...after,...original,game];
}
function expandLegacyActivities(rows){const out=[];for(const a of(rows||[])){if(a?.type==='rotation2'){const dur=Math.max(1,Number(a.roundDuration)||Math.floor((Number(a.duration)||30)/2));if(a.drillA)out.push({id:(a.id||flexId())+'_a',type:'drill',title:a.groupA||'Drill A',duration:dur,note:a.note||'',drillId:a.drillA});if(a.drillB)out.push({id:(a.id||flexId())+'_b',type:'drill',title:a.groupB||'Drill B',duration:dur,note:a.note||'',drillId:a.drillB});if(!a.drillA&&!a.drillB)out.push({id:a.id||flexId(),type:'drill',title:'Drill',duration:dur,note:a.note||'',drillId:null});}else out.push(a)}return out}
function ensureSessionShape(s){
  const raw=Array.isArray(s.activities)&&s.activities.length?expandLegacyActivities(s.activities):frameworkToActivities(s);
  return {...s,themes:s.themes||themesArray(s.theme),status:s.status||'draft',startTime:s.startTime||'19:05',finishTime:s.finishTime||'21:00',activities:ensureAnchorOrder(raw),createdAt:s.createdAt||s.savedAt||new Date().toISOString(),updatedAt:s.updatedAt||s.savedAt||new Date().toISOString()};
}
function assignedCount(s){const a=ensureSessionShape(s).activities;return a.reduce((n,x)=>n+(x.drillId?1:0),0)}
function requiredActivityCount(s){return ensureSessionShape(s).activities.length}
function activityById(id){return currentSession?.activities?.find(x=>x.id===id)}
function activityDrill(a,parallel=false){return drillById(parallel?a?.parallelDrillId:a?.drillId)}
function minsBetween(start,end){const [sh,sm]=start.split(':').map(Number),[eh,em]=end.split(':').map(Number);return (eh*60+em)-(sh*60+sm)}
function addMinutes(t,m){let [h,mi]=t.split(':').map(Number),n=h*60+mi+Number(m||0);n=((n%1440)+1440)%1440;return String(Math.floor(n/60)).padStart(2,'0')+':'+String(n%60).padStart(2,'0')}
function activityStart(index){let t=currentSession.startTime||'19:05';for(let i=0;i<index;i++)t=addMinutes(t,currentSession.activities[i].duration);return t}
function activityEnd(index){return addMinutes(activityStart(index),currentSession.activities[index].duration)}
function totalActivityMinutes(s=currentSession){return(s?.activities||[]).reduce((n,a)=>n+Number(a.duration||0),0)}
function sessionCapacity(s=currentSession){return minsBetween(s.startTime||'19:05',s.finishTime||'21:00')}
function scheduleSummary(s=currentSession){const used=totalActivityMinutes(s),cap=sessionCapacity(s),delta=cap-used;return{used,cap,delta,end:addMinutes(s.startTime||'19:05',used)}}

function sessionCard(s){s=ensureSessionShape(s);const n=assignedCount(s),req=requiredActivityCount(s),comm=s.status==='committed',sum=scheduleSummary(s);return `<div class="session-card"><div style="display:flex;justify-content:space-between;gap:8px"><h3>${esc(s.title||'Training Session')}</h3><span class="status ${comm?'committed':'draft'}">${comm?'COMMITTED':'DRAFT'}</span></div><div class="meta">${esc(s.date||'No date')} · ${esc(sessionThemeText(s))}</div><div class="progress"><span style="width:${req?100*n/req:0}%"></span></div><div class="meta">${n}/${req} main activities assigned · ${sum.used}/${sum.cap} min planned</div><div class="buttons" style="margin-top:10px"><button onclick="openSession('${s.id}')">${comm?'View Session':'Continue Planning'}</button>${comm?`<button class="ghost" onclick="openSession('${s.id}',true)">Training Night</button><button class="secondary" onclick="printTrainingPackById('${s.id}')">Print / PDF</button>`:''}<button class="danger small" onclick="deleteSession('${s.id}')">Delete</button></div></div>`}
async function createSession(){if(!newDate.value)return alert('Choose a date.');const s={id:'s_'+Date.now(),title:newTitle.value.trim()||'Stokesley Training',date:newDate.value,startTime:'19:05',finishTime:'21:00',themes:themesArray(newThemes.value),notes:newNotes.value.trim(),status:'draft',activities:defaultActivities(),createdAt:new Date().toISOString(),updatedAt:new Date().toISOString(),committedAt:null};await put('sessions',s);sessions=await getAll('sessions');closeModals();openSession(s.id)}
async function openSession(id,startTraining=false){const raw=sessions.find(x=>x.id===id)||(await getAll('sessions')).find(x=>x.id===id);if(!raw)return;currentSession=ensureSessionShape(clone(raw));activeKey=currentSession.activities.find(a=>!a.drillId)?.id||currentSession.activities[0]?.id||'overview';showOnly('builderPage');renderBuilder();if(startTraining)openTrainingMode()}
function renderBuilder(){if(!currentSession)return;const sum=scheduleSummary();sessionMini.innerHTML=`<h2>${esc(currentSession.title)}</h2><div class="meta">${esc(currentSession.date)} · ${esc(currentSession.startTime)}–${esc(currentSession.finishTime)}<br>${esc(sessionThemeText(currentSession))}<br><strong>${sum.used}/${sum.cap} min planned</strong>${sum.delta?` · ${Math.abs(sum.delta)} min ${sum.delta>0?'free':'over'}`:''}</div><div style="margin-top:8px"><span class="status ${currentSession.status==='committed'?'committed':'draft'}">${currentSession.status==='committed'?'COMMITTED':'DRAFT'}</span></div>`;renderTimeline();renderWorkspace();const locked=currentSession.status==='committed';saveDraftBtn.classList.toggle('hidden',locked);commitBtn.classList.toggle('hidden',locked);trainingBtn.classList.toggle('hidden',!locked)}
function renderTimeline(){
  const locked=currentSession.status==='committed';
  timeline.innerHTML=currentSession.activities.map((a,i)=>{const d=activityDrill(a),p=activityDrill(a,true);const done=!!d;return `<div class="tl-row ${done?'complete':'pending'} ${activeKey===a.id?'active':''}" onclick="selectActivity('${a.id}')"><span class="tl-status-icon ${done?'complete':'pending'}">${done?'✓':'→'}</span><div class="tl-top"><span class="tl-time">${activityStart(i)}–${activityEnd(i)}</span><span class="tl-name">${esc(a.title||flexTypeLabel(a.type))}</span></div><div class="slot-line ${d?'assigned':''}"><i class="slot-dot ${d?'done':''}"></i>${esc(d?.name||'Choose drill')}</div>${a.type==='penalty'?`<div class="slot-line ${p?'assigned':''}"><i class="slot-dot ${p?'done':''}"></i>Others: ${esc(p?.name||'Optional parallel drill')}</div>`:''}${!locked&&a.type==='drill'?`<div class="buttons" style="margin:7px 38px 0 78px" onclick="event.stopPropagation()"><button class="small ghost" onclick="moveActivity('${a.id}',-1)">↑</button><button class="small ghost" onclick="moveActivity('${a.id}',1)">↓</button><button class="small danger" onclick="removeActivity('${a.id}')">Remove</button></div>`:''}</div>`}).join('') + (locked?'':`<div style="padding:8px"><button style="width:100%" onclick="addDrillActivity()">+ Add Drill</button></div>`);
