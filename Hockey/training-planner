</style></head><body>
<header><div class="brand"><h1>Stokesley Hockey Training</h1><div class="sub">Session planning & training night</div></div><div class="topnav"><button id="navSessions" class="active" onclick="showHome()">Sessions</button><button id="navDrills" onclick="showDrillLibrary()">Drills</button><button onclick="openDataModal()">Data</button></div></header>

<main id="homePage" class="page"><div class="home-head"><div><h2>Training Sessions</h2><div class="meta">Create a session, build a flexible activity timeline, then commit it for Training Night.</div></div><button onclick="openNewSessionModal()">+ New Session</button></div><div id="todayPanel"></div><div class="section-title">Draft Sessions</div><div id="draftSessions" class="session-list"></div><div class="section-title">Committed Sessions</div><div id="committedSessions" class="session-list"></div></main>

<main id="builderPage" class="builder hidden"><aside class="sidebar"><div id="sessionMini" class="session-mini"></div><div id="timeline" class="timeline"></div><div class="sidebar-foot"><button id="saveDraftBtn" class="secondary" onclick="saveDraft()">Save Draft</button><button id="commitBtn" class="good" onclick="commitSession()">Commit Session</button><button id="trainingBtn" class="hidden" onclick="openTrainingMode()">Start Training Night</button></div></aside><section id="workspace" class="workspace"></section></main>

<main id="drillsPage" class="page hidden"><div class="home-head"><div><h2>Drill Library</h2><div class="meta">Create and maintain drills independently of session planning.</div></div><div class="buttons"><button class="secondary" onclick="exportDrills()">Export Drills</button><button class="secondary" onclick="drillImportFile.click()">Import Drills</button><button class="danger" onclick="clearDrillLibrary()">Clear Drill Library</button><button onclick="openDrillEditor()">+ Create Drill</button></div></div><input id="drillImportFile" class="hidden" type="file" accept="application/json" onchange="importDrillsFile(event)"><div class="filterbar"><div><label>Search</label><input id="librarySearch" placeholder="Search name, focus or tags"></div><div><label>Primary Focus</label><select id="libraryFocus"><option value="">All focuses</option></select></div><button class="secondary" onclick="resetLibraryFilters()">Reset</button></div><div id="libraryGrid" class="drill-grid"></div></main>

<div id="newSessionModal" class="modal hidden"><div class="modal-content narrow"><div class="close-row"><h2>New Training Session</h2><button class="secondary" onclick="closeModals()">Close</button></div><div class="row"><div><label>Date</label><input id="newDate" type="date"></div><div><label>Session Title</label><input id="newTitle" value="Stokesley Training"></div></div><label>Session Themes</label><input id="newThemes" placeholder="e.g. Attacking, Circle Entry, Decision Making"><div class="meta">Use commas to add up to three themes.</div><label>Notes (optional)</label><textarea id="newNotes"></textarea><div class="buttons" style="margin-top:12px"><button onclick="createSession()">Create Session</button></div></div></div>

